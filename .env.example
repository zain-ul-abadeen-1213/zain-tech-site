# Copy this file to ".env" and fill in REAL values.
# NEVER commit .env to git — it holds secrets!

# Database (used by both app and db containers)
DB_HOST=db
DB_NAME=zaindb
DB_USER=zainuser
DB_PASS=change_me_strong_password
DB_ROOT_PASS=change_me_strong_root_password

# Password gate for admin-messages.php
ADMIN_PASSWORD=change_me_admin_password

# Port the app listens on (8080 local, 80 production)
APP_PORT=8080
